# =============================================================================
# SI-DIKA — Environment Variables
# Salin file ini ke .env.local dan isi nilainya.
# JANGAN commit .env.local ke version control.
# =============================================================================

# Database PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/si_dika?schema=public"

# Auth.js — generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-random-32-karakter"

# URL aplikasi (ganti saat deploy ke production)
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# (Opsional) URL produksi
# NEXTAUTH_URL="https://si-dika.sekolah.sch.id"
