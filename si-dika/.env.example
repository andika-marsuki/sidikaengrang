# =============================================================================
# SI-DIKA — Environment Variables
# Salin file ini ke .env.local dan isi nilainya.
# JANGAN commit .env.local ke version control.
# =============================================================================

# ── Database PostgreSQL ──────────────────────────────────────────────────────
# Nama variable harus PERSIS sama dengan yang ada di Vercel / hosting.
# schema.prisma membaca DATABASE_URL_POOLED (runtime) dan PRISMA_DATABASE_URL (direct/migrate).

# Koneksi pooled — digunakan Next.js di runtime (serverless)
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLED_HOST:5432/DATABASE?sslmode=require"

# Koneksi direct — digunakan prisma migrate, prisma seed, prisma studio
PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-random-32-karakter"
NEXTAUTH_SECRET="ganti-dengan-string-random-32-karakter"

# AUTH_URL / NEXTAUTH_URL sengaja tidak diset.
# auth.config.ts menggunakan trustHost: true — host dibaca dari request header otomatis.
